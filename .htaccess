# VitalSport
ErrorDocument 404 /404.html

# Nunca servir ficheros de configuración
<FilesMatch "^\.(env|git)">
    Require all denied
</FilesMatch>

# Una sola versión de la web para Google: https://vitalsport.es/
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteRule ^ https://vitalsport.es%{REQUEST_URI} [L,R=301]

    # /index.html duplica la portada
    RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
    RewriteRule ^index\.html$ / [L,R=301]
</IfModule>

# Compresión
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>

# Caché de navegador (mejora Core Web Vitals)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
